        },
        {
          "insert": " as a "
        },
        {
          "insert": "ConnectorDef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", deliberately absent from "
        },
        {
          "insert": "OBJECT_DEFS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — connections are their own document collection, not an object kind — and "
        },
        {
          "insert": "connectors/types.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/connectors/types.ts",
              "label": "connectors/types.ts"
            }
          }
        },
        {
          "insert": " owns the slice's gesture and overlay vocabulary, with the slice's gesture steppers in "
        },
        {
          "insert": "gestures.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " assembled into the editor's state union by the pipeline."
        }
      ],
      "children": []
    },
    "b-conn-def-types-why-10": {
      "id": "b-conn-def-types-why-10",
      "type": "paragraph",
