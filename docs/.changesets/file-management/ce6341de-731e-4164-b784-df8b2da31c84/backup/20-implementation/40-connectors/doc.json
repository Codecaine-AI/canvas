      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was mixing vendored and local routing code in one folder, which makes the MPL file set impossible to police and invites edits that blend obligations into clean files."
        }
      ],
      "children": []
    },
