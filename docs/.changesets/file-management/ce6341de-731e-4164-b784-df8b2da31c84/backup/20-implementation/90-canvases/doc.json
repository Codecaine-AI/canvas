        {
          "insert": " files and nothing else — no TypeScript modules, no barrel — with eval-run boards under "
        },
        {
          "insert": "canvases/evals/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". One corpus serves three consumers: the studio lists and loads it over the file API, tests import individual files by relative path, and docs embed boards by canvas id; "
        },
        {
          "insert": "packages/canvas/src/index.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exports none of them."
        }
