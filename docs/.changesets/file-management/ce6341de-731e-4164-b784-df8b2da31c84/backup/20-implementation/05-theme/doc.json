          "insert": "tokens.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/theme/tokens.ts",
              "label": "tokens.ts"
            }
          }
        },
        {
          "insert": " owns the small non-color remainder — and consumers reach color only through the resolvers, never by indexing the table."
        }
      ],
      "children": []
    },
    "b-theme-split-why-7": {
      "id": "b-theme-split-why-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was one merged theme-constants module, which the repo had once and retired: it turned every visual constant into a cross-layer import magnet and let consumers depend on table layout instead of roles."
