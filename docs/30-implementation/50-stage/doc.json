      "id": "b-stage-role-1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The presentation layer and its two faces: "
        },
        {
          "insert": "stage/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " owns the document renderer — "
        },
        {
          "insert": "CanvasStage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "ObjectShape",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the grid, the viewport math — with "
        },
        {
          "insert": "editor/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "viewer/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as subdivisions underneath it. Rendering and interaction behavior are owned by design; this area records how the layer is assembled."
        }
      ],
      "children": []
    },
