        },
        {
          "insert": " for project-board integration, "
        },
        {
          "insert": "src/dev/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for flagged dev tooling — each owning its components, state, and adapters, with "
        },
        {
          "insert": "App.tsx",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as thin route wiring."
        }
