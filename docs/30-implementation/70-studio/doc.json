    },
    "b-studio-boards-decision-surfaces": {
      "id": "b-studio-boards-decision-surfaces",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Every surface that renders a board receives the resolved style as "
        },
        {
