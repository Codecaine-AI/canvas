    },
    "b-studio-boards-decision": {
      "id": "b-studio-boards-decision",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b-studio-boards-decision-surfaces",
        "b-studio-boards-decision-background"
