    "b-impl-colocate-decision-25": {
      "id": "b-impl-colocate-decision-25",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "tests are colocated with the code they cover — each slice owns its own "
        },
        {
          "insert": "__tests__/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directory ("
        },
        {
          "insert": "state/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "objects/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "interaction/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "connectors/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "stage/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and each feature slice under "
        },
        {
          "insert": "stage/editor/features/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), with one small cross-cutting suite at "
        },
        {
          "insert": "packages/canvas/src/__tests__",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/__tests__",
              "label": "packages/canvas/src/__tests__"
            }
          }
        },
        {
          "insert": ". Bun runs them on happy-dom via the repo-root "
        },
        {
          "insert": "bunfig.toml",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "bunfig.toml",
              "label": "bunfig.toml"
            }
          }
        },
        {
          "insert": " preload of "
        },
        {
          "insert": "happydom.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the same config's "
        },
        {
          "insert": "root = \"packages\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps the vendored docs-framework submodule's tests out of discovery."
        }
      ],
      "children": []
    },
    "b-impl-colocate-why-26": {
      "id": "b-impl-colocate-why-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was one collected test tree, which detaches coverage from the slice that owns the behavior and turns every refactor into a two-tree edit."
        }
      ],
      "children": []
    },
