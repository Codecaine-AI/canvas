              "kind": "source",
              "path": "bunfig.toml",
              "label": "bunfig.toml"
            }
          }
        },
        {
          "insert": " — including every future slice, which ships its own "
        },
        {
          "insert": "__tests__/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " beside its source."
        }
      ],
      "children": []
    },
    "b-impl-assertions-decision-28": {
      "id": "b-impl-assertions-decision-28",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "pure logic layers ("
        },
        {
          "insert": "state/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "interaction/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "connectors/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") get plain unit tests — inputs to outputs, no rendering; "
        },
        {
          "insert": "stage/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "stage/editor/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " get happy-dom DOM and geometry assertion tests — computed styles, element positions, class names, attribute values — never visual screenshot or snapshot-image tests."
        }
      ],
      "children": []
    },
    "b-impl-assertions-why-29": {
      "id": "b-impl-assertions-why-29",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was screenshot comparison, whose failures are only legible by eyeballing image diffs; assertions on concrete diffable values (a computed pixel width, a hex color, a DOM attribute) keep failures readable."
        }
      ],
      "children": []
    },
    "b-impl-assertions-applies-30": {
      "id": "b-impl-assertions-applies-30",
      "type": "paragraph",
