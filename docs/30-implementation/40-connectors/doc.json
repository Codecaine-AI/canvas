    "b-conn-quarantine-decision-6": {
      "id": "b-conn-quarantine-decision-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "connectors/pathfinding/",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/connectors/pathfinding",
              "label": "connectors/pathfinding/"
            }
          }
        },
        {
          "insert": " is the quarantined vendored core, the BlockSuite-derived A* files and nothing else. Local routing logic ("
        },
        {
          "insert": "routing.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "bend-editing.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "connection-cascade.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") stays outside the folder and consumes it through imports. The license boundary itself (the exact file set, the header rules, and the clean-room-or-listed-file rule) is the repo-wide provenance decision on "
        },
        {
          "insert": "Implementation Overview",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation",
              "label": "Implementation Overview"
            }
          }
        },
        {
          "insert": ", and this entry does not restate it."
        }
      ],
      "children": []
    },
    "b-conn-quarantine-why-7": {
      "id": "b-conn-quarantine-why-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was mixing vendored and local routing code in one folder. That alternative makes the MPL file set impossible to police and invites edits that blend obligations into clean files."
        }
      ],
      "children": []
    },
    "b-conn-quarantine-applies-8": {
      "id": "b-conn-quarantine-applies-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "pathfinding/",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/connectors/pathfinding",
              "label": "pathfinding/"
            }
          }
        },
        {
          "insert": ", including every future routing algorithm, which is either clean-room outside the folder or a tracked derived file inside it."
        }
      ],
      "children": []
    },
    "b-conn-def-types-decision-9": {
      "id": "b-conn-def-types-decision-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the connector def lives in "
        },
        {
          "insert": "connectors/def.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/connectors/def.ts",
              "label": "connectors/def.ts"
            }
          }
        },
        {
          "insert": " as a "
        },
        {
          "insert": "ConnectorDef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", deliberately absent from "
        },
        {
          "insert": "OBJECT_DEFS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " because connections are their own document collection, not an object kind. "
        },
        {
          "insert": "connectors/types.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/connectors/types.ts",
              "label": "connectors/types.ts"
            }
          }
        },
        {
          "insert": " owns the slice's gesture and overlay vocabulary, and the pipeline assembles the slice's gesture steppers in "
        },
        {
          "insert": "gestures.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into the editor's state union."
        }
      ],
      "children": []
    },
    "b-conn-def-types-why-10": {
      "id": "b-conn-def-types-why-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was registering connectors as an ObjectDef, which forces object semantics (geometry, containment, object tools) onto what is a routed relation between objects."
        }
      ],
      "children": []
    },
