    "b-conn-quarantine-decision-6": {
      "id": "b-conn-quarantine-decision-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "connectors/pathfinding/",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/connectors/pathfinding",
              "label": "connectors/pathfinding/"
            }
          }
        },
        {
          "insert": " is the quarantined vendored core, the BlockSuite-derived A* files and nothing else. Local routing logic ("
        },
        {
          "insert": "routing.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "bend-editing.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "connection-cascade.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") stays outside the folder and consumes it through imports. The license boundary itself (the exact file set, the header rules, and the clean-room-or-listed-file rule) is the repo-wide provenance decision on "
        },
        {
          "insert": "Implementation Overview",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-implementation",
              "label": "Implementation Overview"
            }
