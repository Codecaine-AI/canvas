          "insert": "ConnectorDef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", deliberately absent from "
        },
        {
          "insert": "OBJECT_DEFS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " because connections are their own document collection, not an object kind. "
        },
        {
          "insert": "connectors/types.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/connectors/types.ts",
              "label": "connectors/types.ts"
            }
          }
        },
        {
          "insert": " owns the slice's gesture and overlay vocabulary, and the pipeline assembles the slice's gesture steppers in "
        },
        {
          "insert": "gestures.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " into the editor's state union."
        }
