    "b-conn-quarantine-why-7": {
      "id": "b-conn-quarantine-why-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was mixing vendored and local routing code in one folder. That alternative makes the MPL file set impossible to police and invites edits that blend obligations into clean files."
        }
      ],
      "children": []
    },
