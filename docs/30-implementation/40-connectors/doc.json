              "kind": "source",
              "path": "packages/canvas/src/connectors/label-chip.ts",
              "label": "connectors/label-chip.ts"
            }
          }
        },
        {
          "insert": " is the one source of a connection label chip's size and typography. The live connector, the static renderer's "
        },
        {
          "insert": "connectionLabelChipRect",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the agent's lint geometry all call "
        },
        {
          "insert": "connectionLabelChipMetrics",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the workspace style. A sans chip keeps the original character-count width, and a mono chip measures exactly at IBM Plex Mono's 0.6em advance. Both take their height, font, and size from the style tokens."
        }
      ],
      "children": []
    },
    "b-conn-chip-why-14": {
      "id": "b-conn-chip-why-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": a chip sized one way in the lints and painted another passes the crowding check while overlapping on screen, or fails it while reading fine. The rejected alternative was each consumer estimating the chip from its own constants, which held only while one theme existed."
        }
      ],
      "children": []
    },
