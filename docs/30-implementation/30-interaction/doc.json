        {
          "insert": "CanvasPointerEvent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the "
        },
        {
          "insert": "CanvasHit",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " union, the drag and snap thresholds, the resize-handle names; new hit kinds and shared thresholds join this file rather than being declared beside a consumer."
        }
      ],
      "children": []
    },
    "b-ixn-vocabulary-why-10": {
      "id": "b-ixn-vocabulary-why-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
