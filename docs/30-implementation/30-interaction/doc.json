    "b-ixn-dom-free-decision-6": {
      "id": "b-ixn-dom-free-decision-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "interaction/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stays DOM-free pure TypeScript — no React, no DOM types, no listeners. The gesture-state union and the dispatcher assemble above the stage in "
        },
        {
          "insert": "stage/editor/pipeline/",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/stage/editor/pipeline",
              "label": "stage/editor/pipeline/"
            }
          }
        },
        {
          "insert": ", and DOM touch — event normalization, hit-attribute walking, window listeners — lives only at that editor edge."
        }
      ],
      "children": []
    },
    "b-ixn-dom-free-why-7": {
      "id": "b-ixn-dom-free-why-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was housing the machine and its DOM wiring in the kernel, which makes every gesture untestable without a browser and couples the shared vocabulary to one host."
        }
      ],
      "children": []
    },
    "b-ixn-dom-free-applies-8": {
      "id": "b-ixn-dom-free-applies-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "packages/canvas/src/interaction",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/interaction",
              "label": "packages/canvas/src/interaction"
            }
          }
        },
        {
          "insert": " — including every future kernel utility, which takes plain data and returns plain data."
        }
      ],
      "children": []
    },
