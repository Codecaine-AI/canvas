    "b-tm-backends-lead": {
      "id": "b-tm-backends-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Pretext measures every segment through the active backend. A switch clears Pretext's caches and calls each "
        },
        {
          "insert": "onBackendChange",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " listener, so layouts measure again in the new widths. The newest of "
        },
        {
          "insert": "useTableBackend()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "useHarfBuzz()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "useBrowserFonts()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " wins, and a request that fails withdraws itself."
        }
      ],
      "children": []
    },
