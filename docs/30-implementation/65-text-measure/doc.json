    "b-tm-guarantee-weights": {
      "id": "b-tm-guarantee-weights",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every weight from 1 to 1000 snaps to the face that CSS font matching picks, such as 620 to Bold and Plex 700 to 600. Chromium paints that face as is, with no synthetic bold, so a snapped weight stays reliable."
        }
