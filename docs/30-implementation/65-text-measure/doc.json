    "b-tm-guarantee-lead": {
      "id": "b-tm-guarantee-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Against headless Chromium 153 on macOS, the HarfBuzz backend gives the DOM's line count on every covered layout, widths within 1/64 px, and "
        },
        {
          "insert": "fitText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " verdicts that never contradict the DOM. The guarantee holds only under three conditions:"
        }
      ],
      "children": []
    },
    "b-tm-guarantee-face": {
      "id": "b-tm-guarantee-face",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The surface paints with a bundled face, Inter 3.19 at 400 to 700 or IBM Plex Mono 2.5 at 400 to 600, and its CSS "
        },
        {
          "insert": "font-family",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " starts with that family."
        }
      ],
      "children": []
    },
    "b-tm-guarantee-edge": {
      "id": "b-tm-guarantee-edge",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "An answer within 1 px of the box edge reads as "
        },
        {
          "insert": "borderline",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never as "
        },
        {
          "insert": "fits",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "overflows",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-tm-guarantee-coverage": {
      "id": "b-tm-guarantee-coverage",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Every character is covered. Characters the faces lack, such as CJK, emoji, and Arabic, are listed in "
        },
        {
          "insert": "uncovered",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " because each machine paints them in its own fallback font."
        }
      ],
      "children": [
        "b-tm-guarantee-coverage-estimate"
      ]
    },
    "b-tm-guarantee-coverage-estimate": {
      "id": "b-tm-guarantee-coverage-estimate",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Their widths are estimates: 1em for CJK, Chromium's macOS emoji advance for emoji, and the face's average letter otherwise."
        }
      ],
      "children": []
    },
    "b-tm-guarantee-unreliable": {
