    "b-tm-role": {
      "id": "b-tm-role",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "@codecaine-ai/text-measure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " measures, wraps, and fits text the way Chromium paints it, without rendering a page. Canvas, sequence, and docs-system lint, lay out, and render through it, so a label that a lint calls fitting fits on screen. Pretext 0.0.9 breaks the lines, and the active backend supplies the widths. The package lives in "
        },
        {
          "insert": "packages/text-measure",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/text-measure",
              "label": "packages/text-measure"
            }
          }
        },
        {
          "insert": ", and its "
        },
        {
          "insert": "README",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/text-measure/README.md",
              "label": "README"
            }
          }
        },
        {
          "insert": " holds every signature and the accuracy commands."
        }
      ],
      "children": []
    },
