    "b-obj-recipe-why-8": {
      "id": "b-obj-recipe-why-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was per-shape logic spread across editor, renderer, and schema, which is how shape zoos rot. The closed recipe means the compiler and two tests ("
        },
        {
          "insert": "geometry-def-agreement.test.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/__tests__/geometry-def-agreement.test.ts",
              "label": "geometry-def-agreement.test.ts"
            }
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "type-defaults.test.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/__tests__/type-defaults.test.ts",
              "label": "type-defaults.test.ts"
            }
          }
        },
        {
          "insert": ") walk an author through anything missed."
        }
      ],
      "children": []
    },
    "b-obj-recipe-applies-9": {
      "id": "b-obj-recipe-applies-9",
      "type": "paragraph",
      "props": {},
      "text": [
