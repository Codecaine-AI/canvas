    "b-obj-recipe-decision-7": {
      "id": "b-obj-recipe-decision-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": a new shape is one new ShapeDef file under "
        },
        {
          "insert": "objects/shapes/",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/shapes",
              "label": "objects/shapes/"
            }
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "basic/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "flowchart/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "icon/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ") holding its silhouette, css, and catalog metadata, with "
        },
        {
          "insert": "shapeObjectDef",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stamping the rest, plus exactly seven one-line registrations. They are the type union in "
        },
        {
          "insert": "object-types.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/object-types.ts",
              "label": "object-types.ts"
            }
          }
        },
        {
          "insert": ", the render-shape variant in "
        },
        {
          "insert": "style.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/style.ts",
              "label": "style.ts"
            }
          }
        },
        {
          "insert": ", the guard branch in "
        },
        {
          "insert": "validate.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/validate.ts",
              "label": "validate.ts"
            }
          }
        },
        {
          "insert": ", the defaults row in "
        },
        {
          "insert": "object-defaults.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/object-defaults.ts",
              "label": "object-defaults.ts"
            }
          }
        },
        {
          "insert": ", the registry entry in "
        },
        {
          "insert": "object-def.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/object-def.ts",
              "label": "object-def.ts"
            }
          }
        },
        {
          "insert": ", the picker placement in "
        },
        {
          "insert": "catalog.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/catalog.ts",
              "label": "catalog.ts"
            }
          }
        },
        {
          "insert": " (labels and keywords derive from the def, and the catalog is arrangement only), and the preview glyph in "
        },
        {
          "insert": "shape-previews.tsx",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/stage/editor/components/shape-previews.tsx",
              "label": "shape-previews.tsx"
            }
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "octagon.tsx",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/shapes/basic/octagon.tsx",
              "label": "octagon.tsx"
            }
          }
        },
        {
          "insert": " is the template. A true outline is the one optional extra: a points builder and exported spec const in "
        },
        {
          "insert": "objects/geometry.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", listed in the dispatch table and referenced from the def. Skipping it ships correct bbox anchors."
        }
      ],
      "children": []
