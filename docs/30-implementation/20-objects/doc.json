    "b-obj-outlines-why-11": {
      "id": "b-obj-outlines-why-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was per-def outline copies, which drift from the hit-testing and anchor dispatch tables and let a connector land where the shape isn't drawn."
