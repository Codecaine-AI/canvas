    "b-obj-registry-decision-13": {
      "id": "b-obj-registry-decision-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the object-preference registry is a repo file, not a service. "
        },
        {
          "insert": "object-preferences.json",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/registry/object-preferences.json",
              "label": "object-preferences.json"
            }
          }
        },
        {
          "insert": " holds the entries in roster order, and the order is load-bearing: the agent's vocabulary listing walks it as-is, and the picker keeps it within each category group. "
        },
        {
          "insert": "registry/index.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/registry/index.ts",
              "label": "registry/index.ts"
            }
          }
        },
        {
          "insert": " is the typed read surface every consumer shares, validating colors at load. There is no change event and no registry-editor surface, so edits are edits to the JSON, picked up at the next load."
        }
      ],
      "children": []
    },
    "b-obj-registry-why-14": {
      "id": "b-obj-registry-why-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was a registry service with change notifications, which buys live propagation nobody needs at the cost of a runtime dependency in every reader."
        }
      ],
      "children": []
    },
    "b-obj-registry-applies-15": {
      "id": "b-obj-registry-applies-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "packages/canvas/src/objects/registry",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/registry",
              "label": "packages/canvas/src/objects/registry"
            }
          }
        },
        {
          "insert": ", including every future vocabulary entry, which joins the JSON in roster order and is read only through "
        },
        {
          "insert": "index.ts",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
