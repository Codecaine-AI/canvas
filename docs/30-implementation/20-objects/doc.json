      "children": []
    },
    "b-obj-text-decision-18": {
      "id": "b-obj-text-decision-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": every piece of object text geometry has one source module that the live stage, the static renderer, the in-place editors, and the agent's text fit all read. "
        },
        {
          "insert": "text-slots.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/text-slots.ts",
              "label": "text-slots.ts"
            }
          }
        },
        {
          "insert": " resolves each slot's rect, its theme typography, and the detail line under the name ("
        },
        {
          "insert": "ResolvedTextSlot.detail",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), and "
        },
        {
          "insert": "section/title-chip-layout.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/section/title-chip-layout.ts",
              "label": "section/title-chip-layout.ts"
            }
          }
        },
        {
          "insert": " lays out the section header chip: placement, icon, title, detail, scale, and width budget."
        }
      ],
      "children": []
    },
    "b-obj-text-why-19": {
      "id": "b-obj-text-why-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": a name, a detail, or a header chip measured one way and painted another clips on one surface and not the other, and the DOM-equivalence tests compare live and static output exactly. The rejected alternative was per-renderer layout code, where each surface measures text its own way."
        }
      ],
      "children": []
    },
    "b-obj-text-applies-20": {
      "id": "b-obj-text-applies-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Applies to",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "text-slots.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/text-slots.ts",
              "label": "text-slots.ts"
            }
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "title-chip-layout.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/objects/section/title-chip-layout.ts",
