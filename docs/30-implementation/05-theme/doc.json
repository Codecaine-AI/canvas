    "b-theme-presets-why-17": {
      "id": "b-theme-presets-why-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": generic controls mean a new token needs no per-token parser or UI code, and a figjam preset equal to the old constants keeps the DOM-equivalence baseline the regression guard for the default look. The rejected alternative was theme branches inside renderers, which would scatter each theme's look across every paint site."
        }
