    "b-ui-editor-style-decision-12": {
      "id": "b-ui-editor-style-decision-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "trim dimensions come from the "
        },
        {
          "insert": "EDITOR_STYLE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " token table in "
        },
        {
          "insert": "editor-style.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/stage/editor/components/editor-style.ts",
              "label": "editor-style.ts"
            }
          }
        },
        {
          "insert": ": the 48px selection toolbar (radius 14, 36px controls, 30px popover swatches, flyouts opening above the toolbar centered on their trigger) deliberately exceeds the measured 29px FigJam pill — a product decision, not a parity gap. Future trim surfaces read "
        },
        {
          "insert": "EDITOR_STYLE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rather than re-deriving sizes from the reference corpus."
        }
      ],
      "children": []
    },
    "b-ui-editor-style-why-13": {
      "id": "b-ui-editor-style-why-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "the rejected alternative was matching the measured baseline literally — under-sized in this product's contexts — while scattering per-component sizes would make the deliberate deviation invisible and un-auditable."
        }
      ],
      "children": []
    },
    "b-ui-editor-style-applies-14": {
