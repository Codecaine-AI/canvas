    "b-ui-vendored-decision-6": {
      "id": "b-ui-vendored-decision-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": UI primitives are duplicated into "
        },
        {
          "insert": "ui/",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/ui",
              "label": "ui/"
            }
          }
        },
        {
          "insert": " (Button, Input, Textarea, Badge, Tooltip, the "
        },
        {
          "insert": "cn()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " helper), never imported from a host component library. The package carries zero dependency on any host app."
        }
      ],
      "children": []
    },
    "b-ui-vendored-why-7": {
      "id": "b-ui-vendored-why-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was re-exporting a host's primitives, which is how the package was born entangled with its original host. Self-containment beats import convenience."
        }
      ],
      "children": []
    },
    "b-ui-vendored-applies-8": {
      "id": "b-ui-vendored-applies-8",
