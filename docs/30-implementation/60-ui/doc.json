      "children": []
    },
    "b-ui-icons-decision-9": {
      "id": "b-ui-icons-decision-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "icons enter through one pipeline: "
        },
        {
          "insert": "ui/icons/manifest.json",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/ui/icons/manifest.json",
              "label": "ui/icons/manifest.json"
            }
          }
        },
        {
          "insert": " selects them, "
        },
        {
          "insert": "tools/nucleo-icons/generate.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "tools/nucleo-icons/generate.ts",
              "label": "tools/nucleo-icons/generate.ts"
            }
          }
        },
        {
          "insert": " emits one component per icon under "
        },
        {
          "insert": "ui/icons/nucleo/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " plus the generated barrel, source SVGs are vendored used-assets-only under "
        },
        {
          "insert": "nucleo/svg/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", hand-authored extras live in "
        },
        {
          "insert": "custom-icons.tsx",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/ui/icons/custom-icons.tsx",
              "label": "custom-icons.tsx"
            }
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "ui/icons/index.ts",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/ui/icons/index.ts",
              "label": "ui/icons/index.ts"
            }
          }
        },
        {
          "insert": " re-exports both. No ad-hoc icon imports, no icon dependency."
        }
      ],
      "children": []
