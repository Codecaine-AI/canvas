          "insert": "SelectionToolbar.tsx",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/stage/editor/features/selection-toolbar/SelectionToolbar.tsx",
              "label": "SelectionToolbar.tsx"
            }
          }
        },
        {
          "insert": " stays generic (resolving glyphs from its own "
        },
        {
          "insert": "ACTION_ICONS",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " table), and the multi-select toolbar is computed as the capability intersection of the selected defs' lists, never hand-authored."
        }
      ],
      "children": []
    },
    "b-ui-toolbar-specs-why-16": {
      "id": "b-ui-toolbar-specs-why-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Why",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": the rejected alternative was a toolbar component per object kind. That alternative duplicates trim per kind and lets the multi-select toolbar drift from what the kinds actually share."
        }
      ],
      "children": []
    },
