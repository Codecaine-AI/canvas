      "id": "b-ui-toolbar-specs-decision-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Decision",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ": selection-toolbar content is data on the defs: each ObjectDef (and the ConnectorDef) carries an icon-free "
        },
        {
          "insert": "ToolbarControlSpec",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " list, the trim host "
