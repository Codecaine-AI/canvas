      "flavour": "paragraph",
      "children": [],
      "props": {},
      "text": [
        {
          "insert": "Indentation is the grammar, exactly like YAML: the lines indented under a container are its children, in order. Nothing else marks nesting. A "
        },
        {
          "insert": "section",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/10-language/20-section",
              "label": "section — a real container object"
            }
          }
        },
        {
          "insert": " has exactly one child; a "
        },
        {
          "insert": "row",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/10-language/10-row-and-col",
              "label": "row and col — weighted splits"
            }
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "col",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/10-language/10-row-and-col",
              "label": "row and col — weighted splits"
            }
          }
        },
        {
          "insert": " has one child per weight; a "
        },
        {
          "insert": "grid",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/10-language/50-grid",
              "label": "grid — a repeated-cell lattice"
            }
          }
        },
        {
          "insert": "'s items fill the lattice row by row; a "
        },
        {
          "insert": "group",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/10-language/40-group",
              "label": "group — a loose cluster"
            }
          }
        },
        {
          "insert": "'s indented lines are always items."
        }
      ]
