        "title": "Geometry quantizes to a 16px grid"
      },
      "text": [
        {
          "insert": "Object geometry uses the 16px grid as a snap unit. It does not prescribe a gap, corridor width, or pitch: choose those for the content and flow, then express the resulting rectangles on-grid."
        }
      ]
    },
    "b-r1-enforce-3": {
      "id": "b-r1-enforce-3",
      "flavour": "paragraph",
      "children": [],
      "props": {},
      "text": [
        {
          "insert": "Mechanism: the "
        },
        {
          "insert": "aesthetic",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "packages/canvas-agent/src/agent/styles/aesthetic.ts",
              "symbol": "style"
            }
          }
        },
        {
          "insert": " tells the agent to work in 16px grid units and to match peers by copying exact digest geometry. The op path applies "
        },
        {
          "insert": "CANVAS_GRID_SIZE = 16",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "CANVAS_GRID_SIZE"
            }
          }
        },
        {
          "insert": " through "
        },
