      },
      "text": [
        {
          "insert": "The ten rules"
        }
      ]
    },
    "b-rulebook-idx-r1-5": {
      "id": "b-rulebook-idx-r1-5",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R1 — The 20 grid",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/01-r1-the-20-grid",
              "label": "R1 — The 20 grid"
            }
          }
        },
        {
          "insert": " — object geometry is quantized to the agent's 20 grid; the grid is a snap unit, not a spacing prescription."
        }
      ]
    },
    "b-rulebook-idx-r2-6": {
      "id": "b-rulebook-idx-r2-6",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R2 — The spacing ladder",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/02-r2-the-spacing-ladder",
              "label": "R2 — The spacing ladder"
            }
          }
        },
        {
          "insert": " — each peer group repeats one exact gap, the ladder names every rung from 48px section padding up to the 160px section gutter, and the crowding warning supplies the corridor floor rather than a target gap."
        }
      ]
    },
    "b-rulebook-idx-r3-7": {
      "id": "b-rulebook-idx-r3-7",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R3 — Section trim",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/03-r3-section-trim",
              "label": "R3 — Section trim"
            }
          }
        },
        {
          "insert": " — sections supply grouping and addressability, children keep air from borders, and a frame is closed around its contents with fit_section when the region is done."
        }
      ]
    },
    "b-rulebook-idx-r4-8": {
      "id": "b-rulebook-idx-r4-8",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R4 — grid: repeated-cell tables",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/04-r4-grid",
              "label": "R4 — grid: repeated-cell tables"
            }
          }
        },
        {
          "insert": " — repeated peers share the largest required size, one exact gap, and centers on a line, copied from digest geometry."
        }
      ]
    },
    "b-rulebook-idx-r5-9": {
      "id": "b-rulebook-idx-r5-9",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R5 — align: cross-branch registers",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/05-r5-align",
              "label": "R5 — align: cross-branch registers"
            }
          }
        },
        {
          "insert": " — peer alignment is a deliberate visual signal, copied exactly and judged from each pushed render."
        }
      ]
    },
    "b-rulebook-idx-r6-10": {
      "id": "b-rulebook-idx-r6-10",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R6 — fan: hub over children",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/06-r6-fan",
              "label": "R6 — fan: hub over children"
            }
          }
        },
        {
          "insert": " — a parent centers over peer children while their repeated gap leaves a readable wire corridor."
        }
      ]
    },
    "b-rulebook-idx-r7-11": {
      "id": "b-rulebook-idx-r7-11",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R7 — hug: margin rails that never stretch",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/07-r7-hug",
              "label": "R7 — hug: margin rails that never stretch"
            }
          }
        },
        {
          "insert": " — content-sized side regions keep air around their contents and live in sections rather than stretching across unused space."
        }
      ]
    },
    "b-rulebook-idx-r8-12": {
      "id": "b-rulebook-idx-r8-12",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R8 — Size semantics",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/08-r8-size-semantics",
              "label": "R8 — Size semantics"
            }
          }
        },
        {
          "insert": " — content determines size from one shared 288×96 target, peers match the largest member, and deliberate size differences communicate importance or exception."
        }
      ]
    },
    "b-rulebook-idx-r9-13": {
      "id": "b-rulebook-idx-r9-13",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R9 — Feedback edges and detours",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/09-r9-feedback-edges",
              "label": "R9 — Feedback edges and detours"
            }
          }
        },
        {
          "insert": " — returns use flow-facing anchors, direct labels, and minimally steered routes through clear corridors."
        }
      ]
    },
    "b-rulebook-idx-r10-14": {
      "id": "b-rulebook-idx-r10-14",
      "flavour": "list-item",
      "children": [],
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "R10 — What the language refuses to say",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "30-agent-layout/20-rulebook/10-r10-what-the-language-refuses-to-say",
              "label": "R10 — What the language refuses to say"
            }
          }
        },
        {
          "insert": " — abstract align, fan, and lattice relations are not operation fields; complete geometry carries the placement and fresh digests plus renders carry the evidence."
        }
      ]
