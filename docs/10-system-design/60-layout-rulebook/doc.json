          "insert": "Rulebook scope"
        }
      ],
      "children": []
    },
    "b-rulebook-lab-body-20": {
      "id": "b-rulebook-lab-body-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R1-R10 are navigation names for recurring composition concerns. Each rule page names the aesthetic, workflow, capability, op-path, and diagnostic mechanisms that own its concern. Those mechanisms, not the rule text, are the enforcement surface. The "
        },
        {
          "insert": "agent layout language",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/50-agent-layout-language",
              "label": "agent layout language"
            }
          }
        },
        {
          "insert": " section shows the resulting composition patterns."
        }
      ],
      "children": []
    }
