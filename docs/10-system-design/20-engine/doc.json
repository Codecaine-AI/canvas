      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The canvas engine is a FigJam-parity, typed-action, world-space diagram engine. Its behavioral spine is short: a validated "
        },
        {
          "insert": "InteractiveCanvasDocument",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/document.ts",
              "symbol": "InteractiveCanvasDocument"
            }
          }
        },
        {
          "insert": " is the only state, a closed "
        },
        {
          "insert": "CanvasAction",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/actions/types.ts",
              "symbol": "CanvasAction"
            }
          }
        },
        {
          "insert": " vocabulary is the only way it changes, one reducer performs every change, and everything on screen — paint order, connector paths, overlays — is derived from that state rather than stored beside it. This page tree specifies that behavior in five areas."
        }
      ],
      "children": []
    },
