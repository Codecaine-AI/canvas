{
  "schemaVersion": 1,
  "id": "canvas-10-system-design-20-engine-10-document-model",
  "title": "Document model",
  "root": "b-engine-model-root",
  "blocks": {
    "b-engine-model-title-1": {
      "id": "b-engine-model-title-1",
      "type": "heading",
      "props": {
        "level": 1
      },
      "text": [
        {
          "insert": "Document model"
        }
      ],
      "children": []
    },
    "b-engine-model-intro-2": {
      "id": "b-engine-model-intro-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The model layer defines what a canvas document is (schema), the closed vocabulary of ways it can change (actions), the single function that performs every change (the reducer), and a small set of pure geometry helpers those changes lean on. Everything above this layer — pointer interaction, connector routing, rendering, the editor shell — reads and writes through these types and functions rather than inventing its own notion of canvas state."
        }
      ],
      "children": []
    },
    "b-engine-model-schema-heading-3": {
      "id": "b-engine-model-schema-heading-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Document schema"
        }
      ],
      "children": []
    },
    "b-engine-model-schema-doc-4": {
      "id": "b-engine-model-schema-doc-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "InteractiveCanvasDocument",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/document.ts",
              "symbol": "InteractiveCanvasDocument"
            }
          }
        },
        {
          "insert": " is the serializable, versioned shape of a canvas: "
        },
        {
          "insert": "schemaVersion",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (always "
        },
        {
          "insert": "1",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), an "
        },
        {
          "insert": "id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", an optional "
        },
        {
          "insert": "title",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a "
        },
        {
          "insert": "mode",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (only "
        },
        {
          "insert": "\"diagram\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " exists), an optional viewport (pan/zoom) and canvas size, and the validated collections: "
        },
        {
          "insert": "objects",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "connections",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and optional "
        },
        {
          "insert": "annotations",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-engine-model-schema-objects-5": {
      "id": "b-engine-model-schema-objects-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each "
        },
        {
          "insert": "InteractiveCanvasObject",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/objects.ts",
              "symbol": "InteractiveCanvasObject"
            }
          }
        },
        {
          "insert": " carries an id, a "
        },
        {
          "insert": "type",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from the closed object-type vocabulary, a single required "
        },
        {
          "insert": "text",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " field (the kind decides where and how it renders), an optional "
        },
        {
          "insert": "color",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pick from the closed 10-swatch roster, an optional "
        },
        {
          "insert": "parentId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " recording section membership, required world-space "
        },
        {
          "insert": "geometry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (x/y/width/height), and optional style/layout/per-type fields ("
        },
        {
          "insert": "direction",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "author",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "icon",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "b-engine-model-schema-connections-6": {
      "id": "b-engine-model-schema-connections-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each "
        },
        {
          "insert": "InteractiveCanvasConnection",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/connections.ts",
              "symbol": "InteractiveCanvasConnection"
            }
          }
        },
        {
          "insert": " links two object endpoints — each with an optional side "
        },
        {
          "insert": "anchor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and an optional precise "
        },
        {
          "insert": "[0..1, 0..1]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " relative "
        },
        {
          "insert": "position",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — and carries line style and arrow direction, its own separate "
        },
        {
          "insert": "label",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", an optional "
        },
        {
          "insert": "color",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " pick, and optional "
        },
        {
          "insert": "waypoints",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": a world-space polyline override that wins over auto-routing when present. "
        },
        {
          "insert": "annotations",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " attach a note or an agent-request to an object, connection, or arbitrary region, with an "
        },
        {
          "insert": "intent",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "status",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lifecycle of their own."
        }
      ],
      "children": []
    },
    "b-engine-model-schema-style-7": {
      "id": "b-engine-model-schema-style-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "CanvasConnectionStyle",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/connections.ts",
              "symbol": "CanvasConnectionStyle"
            }
          }
        },
        {
          "insert": " is line style only: "
        },
        {
          "insert": "\"solid\" | \"dashed\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Routing is always elbow/orthogonal through the routing layer; the style field never selects a path algorithm. "
        },
        {
          "insert": "waypoints",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are the user-bend mechanism: when present, routing honors the stored polyline instead of recomputing around obstacles, and the reducer keeps them coherent — translating them during rigid moves, dropping them after asymmetric moves or resizes, and clearing them when an endpoint object, anchor, or precise position changes, so a reconnected connector returns to auto-routing."
        }
      ],
      "children": []
    },
    "b-engine-model-types-heading-8": {
      "id": "b-engine-model-types-heading-8",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Object types and color"
        }
      ],
      "children": []
    },
    "b-engine-model-types-body-9": {
      "id": "b-engine-model-types-body-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The object-type vocabulary is closed: eleven kinds — "
        },
        {
          "insert": "rectangle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "process",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "decision",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "sticky",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "section",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "arrow-shape",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "predefined-process",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "ellipse",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "triangle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "octagon",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "icon",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — each with a defaults row in "
        },
        {
          "insert": "OBJECT_TYPE_DEFAULTS",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/object-defaults.ts",
              "symbol": "OBJECT_TYPE_DEFAULTS"
            }
          }
        },
        {
          "insert": " and a registered def that owns its rendering and outline. "
        },
        {
          "insert": "section",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the only grouping kind: membership is a persisted, auto-managed "
        },
        {
          "insert": "parentId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", never containment by any other type. The full roster, per-kind trim, and text-slot model are specified in "
        },
        {
          "insert": "the shape API",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/10-shape-api",
              "label": "The shape API"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-engine-model-color-body-10": {
      "id": "b-engine-model-color-body-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Color is a single stored field per object and connection: "
        },
        {
          "insert": "color?: CanvasColor",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — a swatch id from the closed 10-pick roster in "
        },
        {
          "insert": "state/schema/colors.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/colors.ts",
              "symbol": "CanvasColor"
            }
          }
        },
        {
          "insert": ". The id carries no hex; what a pick looks like per kind resolves through the role tables in "
        },
        {
          "insert": "theme/palette.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/theme/palette.ts",
              "symbol": "CANVAS_PALETTE"
            }
          }
        },
        {
          "insert": ". An absent pick renders as the kind's first-use default ("
        },
        {
          "insert": "FIRST_USE_COLORS",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/object-defaults.ts",
              "symbol": "FIRST_USE_COLORS"
            }
          }
        },
        {
          "insert": ": sticky "
        },
        {
          "insert": "\"yellow\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", everything else "
        },
        {
          "insert": "\"gray\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "). New objects take the per-kind last-picked color; connectors are the exception — every connector creation path stamps "
        },
        {
          "insert": "FIRST_USE_COLORS.connector",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a picked connector color is not remembered for future connectors. All object text is one fixed dark color."
        }
      ],
      "children": []
    },
    "b-engine-model-validate-heading-11": {
      "id": "b-engine-model-validate-heading-11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Validation without throwing"
        }
      ],
      "children": []
    },
    "b-engine-model-validate-body-12": {
      "id": "b-engine-model-validate-body-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "validateInteractiveCanvasDocument",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/validate.ts",
              "symbol": "validateInteractiveCanvasDocument"
            }
          }
        },
        {
          "insert": " is a hand-written validator over an "
        },
        {
          "insert": "unknown",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " input. It returns a discriminated "
        },
        {
          "insert": "CanvasValidationResult",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rather than throwing: on success "
        },
        {
          "insert": "{ ok: true, document, warnings? }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", on failure "
        },
        {
          "insert": "{ ok: false, issues }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The key distinction is soft versus hard: an unknown "
        },
        {
          "insert": "color",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is dropped with a warning and normalization continues, while invalid geometry, missing required text, duplicate ids, unknown object types, invalid section parenting, invalid connection endpoints or positions, or malformed "
        },
        {
          "insert": "waypoints",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fail validation. "
        },
        {
          "insert": "assertInteractiveCanvasDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the one place a failed validation becomes a thrown error."
        }
      ],
      "children": []
    },
    "b-engine-model-validate-migration-13": {
      "id": "b-engine-model-validate-migration-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Validation is migration-aware so old documents keep loading: legacy connector styles map forward ("
        },
        {
          "insert": "\"dotted\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "\"dashed\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; "
        },
        {
          "insert": "\"elbow\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "\"smooth\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " to "
        },
        {
          "insert": "\"solid\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), the legacy boolean section lock maps to "
        },
        {
          "insert": "\"background\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and unknown leftover keys from retired schema fields are ignored rather than rejected."
        }
      ],
      "children": []
    },
    "b-engine-model-actions-heading-14": {
      "id": "b-engine-model-actions-heading-14",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Action vocabulary"
        }
      ],
      "children": []
    },
    "b-engine-model-actions-body-15": {
      "id": "b-engine-model-actions-body-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "CanvasAction",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/actions/types.ts",
              "symbol": "CanvasAction"
            }
          }
        },
        {
          "insert": " is a single discriminated union — every variant prefixed "
        },
        {
          "insert": "canvas.",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " — and this closed vocabulary is the entire surface through which a document can change. It covers:"
        }
      ],
      "children": []
    },
