          "insert": "reduceInteractiveCanvasState",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/actions/reducer.ts",
              "symbol": "reduceInteractiveCanvasState"
            }
          }
        },
        {
          "insert": ". Ad hoc mutation anywhere else silently breaks undo history and skips waypoint reconciliation, producing state that looks fine until the next drag or undo exposes the drift."
        }
