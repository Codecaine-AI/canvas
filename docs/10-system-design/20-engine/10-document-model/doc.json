          }
        },
        {
          "insert": " = 16 px, round-to-nearest with width/height floored at one cell), anchor-point resolution, bounding-box math ("
        },
        {
          "insert": "boundsForGeometries",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "boundsForGeometries"
            }
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "documentBounds",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "documentBounds"
            }
          }
        },
        {
          "insert": "), rectangle overlap, "
        },
        {
          "insert": "alignObjects",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "alignObjects"
            }
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "distributeObjects",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "distributeObjects"
            }
          }
        },
        {
          "insert": " (three or more objects, equal gaps along an axis), "
        },
        {
          "insert": "fitSectionToChildren",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "fitSectionToChildren"
            }
          }
        },
        {
          "insert": " (section-only, padded 32 px), transitive membership walking ("
        },
        {
          "insert": "sectionDescendantIds",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "sectionDescendantIds"
            }
          }
        },
        {
          "insert": "), and stable id generation. All are pure document-in/document-out; the corresponding actions are thin reducer cases that call them and run the result through history."
        }
