    "b-engine-model-geometry-coords-26": {
      "id": "b-engine-model-geometry-coords-26",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Every geometry and waypoint is a plain number pair in one flat world-space coordinate system — logical px, no separate world/screen unit split in the schema. The origin is not pinned to anything; objects may have negative coordinates or extend past the document's nominal "
        },
        {
          "insert": "size",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "documentBounds",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
              "symbol": "documentBounds"
            }
          }
        },
        {
          "insert": " always recomputes the real bounding box from actual object geometry rather than trusting "
        },
        {
          "insert": "size",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as authoritative. The 16 px placement-snap grid is a model-layer concern, unrelated to the render layer's adaptive dot grid ("
        },
        {
          "insert": "Stage and viewport",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-engine/40-stage-and-viewport",
              "label": "Stage and viewport"
            }
          }
        },
        {
          "insert": "): one is placement snapping, the other visual density."
        }
      ],
      "children": []
    },
