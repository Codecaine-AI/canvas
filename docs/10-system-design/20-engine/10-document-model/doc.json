        },
        {
          "insert": " is a set of pure, DOM-free functions over plain numbers and "
        },
        {
          "insert": "CanvasGeometry",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " records: grid snapping ("
        },
        {
          "insert": "CANVAS_GRID_SIZE",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/geometry.ts",
