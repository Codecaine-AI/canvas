{
  "schemaVersion": 1,
  "id": "canvas-10-system-design-20-engine-50-persistence-and-embedding",
  "title": "Persistence and embedding",
  "root": "b-engine-persist-root",
  "blocks": {
    "b-engine-persist-root": {
      "id": "b-engine-persist-root",
      "type": "paragraph",
      "props": {
        "concepts": [
          "/api/canvases",
          "canvas.json",
          "autosave",
          "SVG preview",
          "view-only routes",
          "iframe embedding"
        ],
        "covers": "How canvas documents persist and surface: the /api/canvases file API contract, canvases/*.canvas.json as the at-rest format, the autosave contract, deterministic SVG previews, and the editor, view-only, and iframe embedding surfaces.",
        "format": "mdx",
        "type": "design"
      },
      "children": [
        "b-engine-persist-intro-2",
        "b-engine-persist-api-heading-3",
        "b-engine-persist-api-body-4",
        "b-engine-persist-api-list-5",
        "b-engine-persist-api-get-6",
        "b-engine-persist-api-post-7",
        "b-engine-persist-api-delete-8",
        "b-engine-persist-api-invariant-9",
        "b-engine-persist-format-heading-10",
        "b-engine-persist-format-body-11",
        "b-engine-persist-autosave-heading-12",
        "b-engine-persist-autosave-body-13",
        "b-engine-persist-revisions-heading-21",
        "b-engine-persist-revisions-body-22",
        "b-engine-persist-revisions-stale-23",
        "b-engine-persist-revisions-watch-24",
        "b-engine-persist-revisions-clean-25",
        "b-engine-persist-revisions-dirty-26",
        "b-engine-persist-revisions-agent-gate-30",
        "b-engine-persist-revisions-limits-27",
        "b-engine-persist-revisions-electron-28",
        "b-engine-persist-revisions-tabs-29",
        "b-engine-persist-style-heading-31",
        "b-engine-persist-style-body-32",
        "b-engine-persist-style-get-33",
        "b-engine-persist-style-put-34",
        "b-engine-persist-style-watch-35",
        "b-engine-persist-preview-heading-14",
        "b-engine-persist-preview-body-15",
        "b-engine-persist-surfaces-heading-16",
        "b-engine-persist-surfaces-body-17",
        "b-engine-persist-surfaces-decision-18",
        "b-engine-persist-corpus-heading-19",
        "b-engine-persist-corpus-body-20"
      ]
    },
    "b-engine-persist-intro-2": {
      "id": "b-engine-persist-intro-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Persistence is one canonical document store with one file API in front of it. Documents at rest are plain "
        },
        {
          "insert": "*.canvas.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " files. Every surface (editor, read-only viewer, iframe embed, SVG preview, tests) reads the same canonical documents rather than keeping copies."
        }
      ],
      "children": []
    },
    "b-engine-persist-api-heading-3": {
      "id": "b-engine-persist-api-heading-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The /api/canvases file API"
        }
      ],
      "children": []
    },
    "b-engine-persist-api-body-4": {
      "id": "b-engine-persist-api-body-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The backend is one shared handler, "
        },
        {
          "insert": "createCanvasFileApiHandler",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/studio/server/canvas-file-api.ts",
              "symbol": "createCanvasFileApiHandler"
            }
          }
        },
        {
          "insert": ", mounted identically by the web and desktop shells so documents and previews behave the same in both. Ids must match the canvas id pattern and resolve to "
        },
        {
          "insert": "${id}.canvas.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " under the "
        },
        {
          "insert": "canvases/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " directory. The contract:"
        }
      ],
      "children": []
    },
    "b-engine-persist-api-list-5": {
      "id": "b-engine-persist-api-list-5",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "GET /api/canvases",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lists the directory as "
        },
        {
          "insert": "{ id, title, updated_at }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "updated_at",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from file mtime, sorted newest first."
        }
      ],
      "children": []
    },
    "b-engine-persist-api-get-6": {
      "id": "b-engine-persist-api-get-6",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "GET /api/canvases/:id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " returns "
        },
        {
          "insert": "{ id, contentHash, canvas }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with an "
        },
        {
          "insert": "ETag",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " header. "
        },
        {
          "insert": "contentHash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the sha256 of the file bytes. The handler reads the whole file before it answers, so the hash and the body name the same bytes. It reads "
        },
        {
          "insert": "without validating on read",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", because a stored document is trusted at rest."
        }
      ],
      "children": []
    },
    "b-engine-persist-api-post-7": {
      "id": "b-engine-persist-api-post-7",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "POST",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " creates and returns "
        },
        {
          "insert": "409",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " if the file already exists. "
        },
        {
          "insert": "PUT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " replaces. Both validate through "
        },
        {
          "insert": "validateInteractiveCanvasDocument",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/validate.ts",
              "symbol": "validateInteractiveCanvasDocument"
            }
          }
        },
        {
          "insert": ". Invalid documents get "
        },
        {
          "insert": "422",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the issue list. Valid documents are written as pretty-printed JSON. A "
        },
        {
          "insert": "PUT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " that carries "
        },
        {
          "insert": "If-Match",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " writes only when the file on disk still has that content hash. Otherwise it answers "
        },
        {
          "insert": "412",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with the current hash and leaves the file alone. A "
        },
        {
          "insert": "PUT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " without "
        },
        {
          "insert": "If-Match",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " overwrites. A successful "
        },
        {
          "insert": "PUT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " returns the new "
        },
        {
          "insert": "contentHash",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-engine-persist-api-delete-8": {
      "id": "b-engine-persist-api-delete-8",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "DELETE /api/canvases/:id",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " unlinks the file."
        }
      ],
      "children": []
    },
    "b-engine-persist-api-invariant-9": {
      "id": "b-engine-persist-api-invariant-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The write/read asymmetry is deliberate. Validation guards the write path, so the corpus stays clean at rest and reads stay cheap. Anything that produces a canvas file by another path must satisfy the same validator before writing."
        }
      ],
      "children": []
    },
    "b-engine-persist-format-heading-10": {
      "id": "b-engine-persist-format-heading-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The at-rest format"
        }
      ],
      "children": []
    },
    "b-engine-persist-format-body-11": {
      "id": "b-engine-persist-format-body-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A canvas file is a plain, pretty-printed "
        },
        {
          "insert": "InteractiveCanvasDocument",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/canvas/src/state/schema/document.ts",
              "symbol": "InteractiveCanvasDocument"
            }
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "Document model",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/20-engine/10-document-model",
              "label": "Document model"
            }
          }
        },
        {
          "insert": "): no envelope, no side-car metadata. Title lives in the document. Timestamps come from the filesystem. Because the format is the schema itself, any tool that can produce a valid document can produce a board, and migrations operate on the files directly."
        }
      ],
      "children": []
    },
    "b-engine-persist-autosave-heading-12": {
      "id": "b-engine-persist-autosave-heading-12",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The autosave contract"
        }
      ],
      "children": []
    },
    "b-engine-persist-autosave-body-13": {
      "id": "b-engine-persist-autosave-body-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Editing hosts save continuously rather than on request: queue a save on every document change, skip writes when the document is unchanged from the loaded snapshot, debounce into a "
        },
        {
          "insert": "PUT",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " (800 ms in Studio), and flush pending writes on navigation and "
        },
        {
          "insert": "beforeunload",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "keepalive",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " so closing a tab cannot drop the last edit. The trim reports the outcome as Saved or Save failed (retry). Opening a board deep-clones the fetched document and snapshots it for the dirty check."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-heading-21": {
      "id": "b-engine-persist-revisions-heading-21",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Revisions and external changes"
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-body-22": {
      "id": "b-engine-persist-revisions-body-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A canvas file can change while an editor has it open: an agent saves through the Canvas MCP, a person edits the JSON, or git checks out another revision. One content hash, the sha256 of the file bytes, names one on-disk revision for every writer. The file API returns it, the layout agent's Accept compares it, and the Canvas MCP compares it before each save. No writer merges."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-stale-23": {
      "id": "b-engine-persist-revisions-stale-23",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "Studio sends the hash of its last load or save as "
        },
        {
          "insert": "If-Match",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on every autosave. A "
        },
        {
          "insert": "412",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " raises the notice "
        },
        {
          "insert": "Canvas changed on disk",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "Reload",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "Keep mine",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", and autosave holds the local edits until the operator picks one."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-watch-24": {
      "id": "b-engine-persist-revisions-watch-24",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The Vite dev server watches "
        },
        {
          "insert": "canvases/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through "
        },
        {
          "insert": "createCanvasChangeNotifier",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "packages/studio/server/canvas-file-watch.ts",
              "symbol": "createCanvasChangeNotifier"
            }
          }
        },
        {
          "insert": ". A changed file is rehashed and announced to the client as a "
        },
        {
          "insert": "canvas:file-changed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " HMR event carrying the canvas id and the new hash. The file API records the hash of each write before it lands, so Studio's own saves announce nothing."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-clean-25": {
      "id": "b-engine-persist-revisions-clean-25",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A board with no pending or in-flight save reloads in place. Studio refetches the file and calls the editor's "
        },
        {
          "insert": "loadDocument",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Undo history, selection, and the active tool reset as on a fresh mount, and the camera stays where it is."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-dirty-26": {
      "id": "b-engine-persist-revisions-dirty-26",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A board with unsaved edits shows the same notice instead of reloading. "
        },
        {
          "insert": "Reload",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " drops the local edits and loads the file. "
        },
        {
          "insert": "Keep mine",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " saves the local board without "
        },
        {
          "insert": "If-Match",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and overwrites the external change."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-agent-gate-30": {
      "id": "b-engine-persist-revisions-agent-gate-30",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "An unresolved conflict blocks the layout agent. Studio refuses to start an agent run until the operator picks "
        },
        {
          "insert": "Reload",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "Keep mine",
          "attributes": {
            "bold": true
          }
        },
        {
          "insert": ", because the board in memory is not the file the harness reads. A run would scope against one and patch the other."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-limits-27": {
      "id": "b-engine-persist-revisions-limits-27",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Two limits apply to the current shells."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-electron-28": {
      "id": "b-engine-persist-revisions-electron-28",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The Electron shell mounts the file API without the watcher and has no HMR channel. It gets the "
        },
        {
          "insert": "412",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " check and no live reload, so an external change surfaces on the next save."
        }
      ],
      "children": []
    },
    "b-engine-persist-revisions-tabs-29": {
      "id": "b-engine-persist-revisions-tabs-29",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "A second Studio tab receives no event for the first tab's saves, because Studio's own writes are filtered out. It learns of them from the "
        },
        {
          "insert": "412",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on its next save."
        }
      ],
      "children": []
    },
    "b-engine-persist-style-heading-31": {
      "id": "b-engine-persist-style-heading-31",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Workspace Style Settings"
        }
      ],
      "children": []
    },
    "b-engine-persist-style-body-32": {
      "id": "b-engine-persist-style-body-32",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "One more file lives beside the boards: "
        },
        {
          "insert": "canvases/canvas-style.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the workspace's active theme and each theme's overrides ("
        },
        {
          "insert": "workspace themes",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-system-design/15-themes",
              "label": "workspace themes"
            }
          }
        },
        {
          "insert": "). It is a settings file, not a board, so it has its own route in the same shared handler and never passes through the canvas validator."
        }
      ],
      "children": []
    },
    "b-engine-persist-style-get-33": {
      "id": "b-engine-persist-style-get-33",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "GET /api/canvas-style",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " returns the normalized settings document as "
        },
        {
          "insert": "settings",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the active theme resolved with every value clamped as "
        },
        {
          "insert": "style",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the active theme's overrides as "
        },
        {
          "insert": "overrides",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A missing or malformed file reads as figjam with no overrides."
        }
      ],
      "children": []
    },
    "b-engine-persist-style-put-34": {
      "id": "b-engine-persist-style-put-34",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "PUT /api/canvas-style",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " accepts "
        },
        {
          "insert": "{ settings }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or the pre-theme body "
        },
        {
          "insert": "{ overrides }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which replaces the active theme's overrides. The handler normalizes the settings, drops preset-equal values and themes left without overrides, writes "
        },
        {
          "insert": "{ theme, themes }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " as pretty JSON, and deletes the file when the settings equal the defaults."
        }
      ],
      "children": []
    },
    "b-engine-persist-style-watch-35": {
      "id": "b-engine-persist-style-watch-35",
      "type": "list-item",
      "props": {
        "ordered": false
      },
      "text": [
        {
          "insert": "The dev server watches the file like a board and announces an external write as a "
        },
        {
          "insert": "canvas:style-changed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " HMR event carrying the new content hash, or null after a delete. Studio's own writes announce nothing, and a pushed value never overwrites a local edit made after the fetch started."
        }
      ],
      "children": []
    },
    "b-engine-persist-preview-heading-14": {
      "id": "b-engine-persist-preview-heading-14",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "SVG previews"
        }
      ],
      "children": []
    },
    "b-engine-persist-preview-body-15": {
      "id": "b-engine-persist-preview-body-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "GET /api/canvases/:id/preview.svg?section=&w=&h=",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is the lightweight read surface for dashboards, documentation cards, and other inline hosts. The API loads the document, renders it through "
        },
