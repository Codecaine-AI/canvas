    "b-engine-persist-surfaces-decision-18": {
      "id": "b-engine-persist-surfaces-decision-18",
      "type": "callout",
      "props": {
        "kind": "decision",
        "status": "accepted",
        "title": "Keep inline previews static; expand to navigate; edit separately"
      },
      "text": [
        {
          "insert": "An inline canvas card shows the section crop without capturing drag or wheel input. An explicit full-screen action promotes it to the interactive read-only viewer, where pan and zoom are expected. Authoring is a third context: an explicit edit action opens the editor separately so the reader does not lose the surrounding document or page state. This progression is a portable host contract, not behavior specific to any one embedding host."
        }
      ],
      "children": []
