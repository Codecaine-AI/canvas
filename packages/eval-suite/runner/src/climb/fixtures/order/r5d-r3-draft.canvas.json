      }
    },
    {
      "id": "k-recon",
      "type": "sticky",
      "text": "**reconcileConnectionWaypoints** translates waypoints on a rigid move and drops them on an asymmetric move or resize.\n**Known gap**: a commit replays the whole proposal, so asymmetric net movement can lose waypoints on replay.\n**reconcileSectionMembership** derives each parentId from geometry.",
      "color": "yellow",
      "parentId": "sub-recon",
      "geometry": {
        "x": 780,
        "y": 1380,
        "width": 280,
